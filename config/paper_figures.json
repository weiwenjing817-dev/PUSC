{
  "paper_model_name": "GEODE",
  "framework_figure": "view/final.png",
  "default_output_dir": "result/figures/paper_vector",
  "condition_key_columns": ["perturbation", "cell_type"],
  "datasets": {
    "norman": {
      "label": "Norman",
      "claim": "generalization to held-out combinatorial genetic perturbations",
      "biology_focus": "genetic interaction and response-gene recovery"
    },
    "combosciplex": {
      "label": "ComboSciPlex",
      "claim": "drug-combination response prediction",
      "biology_focus": "dose/drug-combination transcriptional response"
    },
    "kang_ifnb": {
      "label": "Kang IFN-beta",
      "claim": "cell-type-context generalization for IFN-beta response",
      "biology_focus": "cell-type-specific interferon-stimulated gene response"
    },
    "pc9": {
      "label": "PC9",
      "claim": "held-out targeted therapy combination response",
      "biology_focus": "EGFR/ALK drug-combination mechanism and synergy"
    }
  },
  "metrics": {
    "pearson_delta": {
      "label": "Delta Pearson",
      "direction": "higher",
      "set": "core",
      "claim": "mean perturbation effect concordance"
    },
    "de_spearman_sig": {
      "label": "DE Spearman",
      "direction": "higher",
      "set": "core",
      "claim": "rank concordance on significant response genes"
    },
    "de_direction_match": {
      "label": "DE direction match",
      "direction": "higher",
      "set": "core",
      "claim": "up/down regulation direction recovery"
    },
    "de_sig_genes_recall": {
      "label": "DE gene recall",
      "direction": "higher",
      "set": "core",
      "claim": "response-gene coverage"
    },
    "pr_auc": {
      "label": "PR AUC",
      "direction": "higher",
      "set": "biology",
      "claim": "significant response-gene detection"
    },
    "roc_auc": {
      "label": "ROC AUC",
      "direction": "higher",
      "set": "biology",
      "claim": "response-gene classification"
    },
    "mse_delta": {
      "label": "Delta MSE",
      "direction": "lower",
      "set": "error",
      "claim": "lower perturbation effect error"
    },
    "mae_delta": {
      "label": "Delta MAE",
      "direction": "lower",
      "set": "error",
      "claim": "lower absolute perturbation effect error"
    }
  },
